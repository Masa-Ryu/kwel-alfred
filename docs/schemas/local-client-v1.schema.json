{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Masa-Ryu/kwel-connect/raw/main/docs/schemas/local-client-v1.schema.json",
  "title": "Kwel Local Client v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "type": {
              "const": "profile-probe"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "x-utf16-maxLength": 100
            },
            "profileId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "v",
            "type",
            "requestId",
            "profileId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "type": {
              "const": "search"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "x-utf16-maxLength": 100
            },
            "profileId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "query": {
              "type": "string",
              "maxLength": 200,
              "x-utf16-maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "v",
            "type",
            "requestId",
            "profileId",
            "query",
            "limit"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "type": {
              "const": "open-page"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "x-utf16-maxLength": 100
            },
            "profileId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "openRef": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "v",
            "type",
            "requestId",
            "profileId",
            "openRef"
          ]
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "type": {
              "const": "profile-info"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "x-utf16-maxLength": 100
            },
            "profileId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "profileLabel": {
              "type": "string",
              "maxLength": 64,
              "x-utf16-maxLength": 64,
              "pattern": "^[^\\r\\n]*$"
            },
            "hostVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "v",
            "type",
            "requestId",
            "profileId",
            "profileLabel",
            "hostVersion"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "type": {
              "const": "search-result"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "x-utf16-maxLength": 100
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "url",
                  "domain",
                  "openRef"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  "domain": {
                    "type": "string"
                  },
                  "openRef": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                  }
                }
              }
            },
            "hasMore": {
              "type": "boolean"
            }
          },
          "required": [
            "v",
            "type",
            "requestId",
            "items",
            "hasMore"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "type": {
              "const": "open-result"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "x-utf16-maxLength": 100
            },
            "ok": {
              "const": true
            }
          },
          "required": [
            "v",
            "type",
            "requestId",
            "ok"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 1
            },
            "type": {
              "const": "error"
            },
            "requestId": {
              "type": "string",
              "maxLength": 100
            },
            "code": {
              "enum": [
                "BAD_REQUEST",
                "INVALID_REQUEST",
                "INCOMPATIBLE_VERSION",
                "NOT_READY",
                "RESULT_EXPIRED",
                "OPEN_FAILED",
                "SEARCH_FAILED",
                "PROFILE_CONFLICT",
                "HOST_NOT_FOUND",
                "DISCONNECTED",
                "TIMEOUT",
                "PERMISSION_REQUIRED",
                "BUSY",
                "UNSAFE_PATH",
                "INSTALL_CONFLICT",
                "DOWNGRADE_REFUSED",
                "HOST_IN_USE"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "v",
            "type",
            "requestId",
            "code",
            "message"
          ]
        }
      ]
    }
  }
}
